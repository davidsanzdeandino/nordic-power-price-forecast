# =============================================================================
#  Environment variables - Nordic day-ahead price forecast
# =============================================================================
#  Copy this file to `.env` and fill in your keys.
#
#  ENTSO-E Transparency Platform - free API token (required):
#    1. Register at https://transparency.entsoe.eu/ (free).
#    2. Email transparency@entsoe.eu from the registered address with the
#       subject "Restful API access".
#    3. Once approved: Account Settings -> "Web Api Security Token"
#       -> "Generate a new token".
#
#  Fingrid Open Data (Finnish TSO) - free API key, required to reproduce FI:
#    1. Register at https://data.fingrid.fi/ (free).
#    2. Subscribe to the "Open Data starter" product.
#    3. Copy your "Primary key" from your profile -> Your subscriptions.
#    Without it, steps 11 and 12 raise an error (the rest of the pipeline
#    continues and exits with code 1) and FI is trained without the Fingrid
#    forecasts, so its results differ from the published ones.
#
#  The LightGBM thread count is read from the shell environment variable
#  LGBM_N_JOBS (default -1, all cores), not from this file.
#
#  The real `.env` file is in .gitignore and must never be committed.
#  Regenerate any key that has been exposed.
# =============================================================================

ENTSOE_API_KEY=your_entsoe_token_here
FINGRID_API_KEY=your_fingrid_primary_key_here
